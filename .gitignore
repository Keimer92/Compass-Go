# ============================================
# .gitignore para Go
# ============================================

# --- Binarios y pruebas ---
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# --- Editor / entorno local ---
.vscode/
.idea/
.env
.env.*
!.env.example
*.log

# --- Task (go-task): cache de checksums ---
.task/

# --- Windows ---
$RECYCLE.BIN/
ehthumbs.db
*.lnk

# Compass project ignore rules
*.syso
coverage.out
*.coverprofile
node_modules/
frontend/node_modules/
frontend/dist/
frontend/bindings/
dist/
**/frontend/dist/
