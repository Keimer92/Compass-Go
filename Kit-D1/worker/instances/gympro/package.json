{
  "name": "gympro-sync-kit-worker",
  "private": true,
  "version": "0.1.0",
  "description": "GymPro instance of the sync-kit worker template",
  "type": "module",
  "scripts": {
    "assemble": "node ../../scripts/build-instance.mjs gympro",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8793",
    "deploy": "wrangler deploy",
    "migrate:turso": "node ../../../scripts/migrate-turso.mjs --dir ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.156.0"
  }
}
